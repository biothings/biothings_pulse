# Copy to terraform.tfvars and adjust.
aws_region    = "us-west-2"
project_name  = "biothings-pulse"

# Leave empty on the first apply (creates the ECR repo). After pushing your
# image, either re-apply (defaults to <ecr_url>:latest) or pin a tag here:
# container_image = "123456789012.dkr.ecr.us-west-2.amazonaws.com/biothings-pulse:v0.1.0"

cpu            = 512
memory         = 1024
desired_count  = 1

# Keep the in-app scheduler on for a single task; turn off if you scale out.
scheduler_enabled  = true
scheduler_interval = 86400

# extra_environment = {
#   PULSE_CHECK_TIMEOUT = "90"
# }
