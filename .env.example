# Copy to .env for local development (loaded automatically by pydantic-settings).

# --- Plugin sourcing ---
# PULSE_REGISTRY_FILE=./my_registry.yaml
PULSE_CACHE_DIR=.cache/repos
PULSE_SYNC_ON_STARTUP=true

# --- Check behaviour ---
PULSE_CHECK_TIMEOUT=60
PULSE_MAX_CHECK_WORKERS=8

# --- Scheduler ---
PULSE_SCHEDULER_ENABLED=true
# Default per-source cadence (s) for sources without their own cron schedule.
PULSE_SCHEDULER_INTERVAL=86400
# How often the scheduler wakes to check which sources are due (s).
PULSE_SCHEDULER_TICK=3600

# --- State store (sqlite for local dev) ---
PULSE_STORE_BACKEND=sqlite
PULSE_SQLITE_PATH=.cache/pulse_state.db

# --- DynamoDB (AWS) ---
# PULSE_STORE_BACKEND=dynamodb
# PULSE_DYNAMODB_TABLE=biothings-pulse-state
# PULSE_AWS_REGION=us-west-2
# PULSE_DYNAMODB_ENDPOINT_URL=http://localhost:8000

# --- Server ---
PULSE_HOST=0.0.0.0
PULSE_PORT=8080
PULSE_LOG_LEVEL=info

# --- Admin auth ---
# Shared secret required for mutating ops (sync/refresh/force-check). Unset =>
# those ops are disabled and the API/dashboard are read-only. Send as
# `Authorization: Bearer <token>` (or the X-Admin-Token header); the dashboard
# has an "admin" unlock button.
# PULSE_ADMIN_TOKEN=change-me
